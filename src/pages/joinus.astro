---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import LangBlock from "../components/i18n/LangBlock.astro";
---

<BaseLayout
    title="Join Us"
    description="Join ASI² Lab at NTUST — open positions for graduate students and research assistants in AI, computer vision, robotics, and industrial AIoT. Learn how to apply."
>
    <!-- Hero -->
    <section class="relative bg-navy text-white py-24 overflow-hidden">
        <div
            class="absolute inset-0 bg-gradient-to-br from-navy via-navy-light to-navy opacity-90"
        >
        </div>
        <!-- Abstract Tech Pattern -->
        <svg
            class="absolute inset-0 w-full h-full opacity-10"
            width="100%"
            height="100%"
            xmlns="http://www.w3.org/2000/svg"
        >
            <defs>
                <pattern
                    id="grid-pattern"
                    width="40"
                    height="40"
                    patternUnits="userSpaceOnUse"
                >
                    <path
                        d="M0 40L40 0H20L0 20M40 40V20L20 40"
                        stroke="currentColor"
                        stroke-width="1"
                        fill="none"></path>
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid-pattern)"></rect>
        </svg>

        <div
            class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10"
        >
            <span
                class="inline-block py-1 px-3 rounded-full bg-accent/20 text-accent text-sm font-semibold mb-6 border border-accent/20 backdrop-blur-sm"
            >
                <span data-lang-en>Join the ASI² Lab</span><span data-lang-zh>加入 ASI² Lab</span>
            </span>
            <h1
                class="text-5xl md:text-6xl font-heading font-bold mb-6 tracking-tight leading-tight"
            >
                <span data-lang-en>Shape the Future of <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-light"
                    >Intelligent Systems</span
                ></span><span data-lang-zh>共同塑造 <br />
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-accent-light"
                    >智慧系統的未來</span
                ></span>
            </h1>
            <p class="text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed">
                <span data-lang-en>We are looking for passionate researchers to pioneer
                breakthroughs in Robotics, AI, and Industrial Automation.</span><span data-lang-zh>我們正尋找充滿熱情的研究者，共同在 Robotics、AI 與 Industrial Automation 領域開創突破。</span>
            </p>
        </div>
    </section>

    <!-- Contact Info -->
    <section class="section-padding bg-gray-50">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <SectionHeader
                title="Contact Information"
                titleZh="聯絡資訊"
                subtitle="Get in touch with us"
                subtitleZh="歡迎與我們聯繫"
            />

            <div class="grid md:grid-cols-2 gap-8">
                <div
                    class="p-8 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 group/card relative overflow-hidden cursor-pointer"
                    onclick="if(!event.target.closest('a')) window.location.href='/about'"
                >
                    <!-- Watermark Logo -->
                    <div
                        class="absolute -bottom-10 left-1/2 -translate-x-1/2 w-80 h-50 opacity-[0.50] group-hover/card:opacity-[0.80] transition-all duration-500 group-hover/card:scale-110 pointer-events-none"
                    >
                        <img
                            src="/images/Logo2.png"
                            alt="ASI Lab Logo"
                            class="w-full h-full object-contain"
                        />
                    </div>

                    <h3
                        class="text-xl font-semibold text-navy mb-6 flex items-center gap-3 relative z-10"
                    >
                        <div
                            class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center text-accent group-hover/card:bg-accent group-hover/card:text-white transition-colors duration-300"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                                ></path></svg
                            >
                        </div>
                        <span
                            class="group-hover/card:text-accent transition-colors duration-300"
                            >Dr. Sin-Ye Jhong 鍾昕燁</span
                        >
                    </h3>

                    <div class="space-y-4 relative z-10">
                        <a
                            href="mailto:sinyejhong@mail.ntust.edu.tw"
                            class="flex items-center gap-3 text-navy hover:text-accent transition-colors group"
                        >
                            <div
                                class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center group-hover:bg-accent/10 transition-colors"
                            >
                                <svg
                                    class="w-4 h-4 text-accent"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path></svg
                                >
                            </div>
                            <span class="font-medium text-sm"
                                >sinyejhong@mail.ntust.edu.tw</span
                            >
                        </a>

                        <div class="flex items-start gap-3 text-navy">
                            <div
                                class="w-8 h-8 rounded-lg bg-gray-50 flex items-center justify-center flex-shrink-0 mt-1"
                            >
                                <svg
                                    class="w-4 h-4 text-accent"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                    ><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    ></path><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path></svg
                                >
                            </div>
                            <div class="flex-grow text-sm">
                                <p class="font-medium text-base text-navy mb-1">
                                    <span data-lang-en>Lab Address</span><span data-lang-zh>實驗室地址</span>
                                </p>
                                <LangBlock as="p" class="text-gray-600 leading-relaxed">
                                    <Fragment slot="en">C216, 2F, General Education Building<br />
                                    <span class="font-medium text-navy"
                                        >TaiwanTech Hwa Hsia Campus</span
                                    ><br />
                                    No.111, Gongzhuan Rd., Zhonghe Dist.,<br />
                                    New Taipei City, Taiwan</Fragment>
                                    <Fragment slot="zh">新北市 <span class="font-medium text-navy">國立臺灣科技大學 華夏校區</span><br />
                                    通識教育大樓 2 樓 C216<br />
                                    中和區公專路 111 號</Fragment>
                                </LangBlock>
                            </div>
                        </div>
                    </div>
                </div>

                <div
                    class="p-8 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
                >
                    <h3
                        class="text-xl font-semibold text-navy mb-6 flex items-center gap-3"
                    >
                        <div
                            class="w-12 h-12 bg-navy/10 rounded-xl flex items-center justify-center text-navy"
                        >
                            <svg
                                class="w-6 h-6"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                ></path><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                ></path></svg
                            >
                        </div>
                        <span data-lang-en>Lab Location</span><span data-lang-zh>實驗室位置</span>
                    </h3>
                    <div
                        class="aspect-[4/3] bg-gray-100 rounded-xl overflow-hidden border border-gray-100 shadow-inner"
                    >
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1051.3250612295649!2d121.50709557020976!3d24.981232821866893!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x346802694c303d77%3A0x806bf2c0d4f5b471!2z6I-v5aSP56eR5oqA5aSn5a24!5e0!3m2!1szh-TW!2stw!4v1780908288763!5m2!1szh-TW!2stw"
                            class="w-full h-full border-0"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                            title="Lab Location Map"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Join Us -->
    <section class="py-16 bg-white border-b border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <SectionHeader
                title="Why Join ASI² Lab?"
                titleZh="為什麼加入 ASI² Lab？"
                subtitle="We provide a world-class research environment to help you achieve your academic and professional goals."
                subtitleZh="我們提供世界級的研究環境，協助您實現學術與職涯目標。"
            />

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Benefit 1 -->
                <div
                    class="p-6 bg-gray-50 rounded-2xl border border-gray-100 hover:shadow-lg transition-all duration-300 group"
                >
                    <div
                        class="w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-transform text-accent"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                            ></path></svg
                        >
                    </div>
                    <h3 class="text-xl font-semibold text-navy mb-2">
                        <span data-lang-en>Cutting-edge Research</span><span data-lang-zh>尖端研究</span>
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        <span data-lang-en>Work on state-of-the-art projects in Resilient
                        Perception, Industrial AIoT, and Embodied Intelligence
                        funded by top agencies.</span><span data-lang-zh>參與由頂尖機構資助的最新 Resilient Perception、Industrial AIoT 與 Embodied Intelligence 專案。</span>
                    </p>
                </div>

                <!-- Benefit 2 -->
                <div
                    class="p-6 bg-gray-50 rounded-2xl border border-gray-100 hover:shadow-lg transition-all duration-300 group"
                >
                    <div
                        class="w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-transform text-teal-600"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                            ></path></svg
                        >
                    </div>
                    <h3 class="text-xl font-semibold text-navy mb-2">
                        <span data-lang-en>Mentorship & Growth</span><span data-lang-zh>導師輔導與成長</span>
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        <span data-lang-en>Receive personalized guidance from Dr. Jhong and regular
                        feedback to prepare you for top-tier academic or
                        industrial careers.</span><span data-lang-zh>由 Dr. Jhong 提供個人化指導與定期回饋，協助您邁向頂尖學術或業界職涯。</span>
                    </p>
                </div>

                <!-- Benefit 3 -->
                <div
                    class="p-6 bg-gray-50 rounded-2xl border border-gray-100 hover:shadow-lg transition-all duration-300 group"
                >
                    <div
                        class="w-12 h-12 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4 group-hover:scale-110 transition-transform text-purple-600"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                            ></path></svg
                        >
                    </div>
                    <h3 class="text-xl font-semibold text-navy mb-2">
                        <span data-lang-en>Global Impact</span><span data-lang-zh>國際影響力</span>
                    </h3>
                    <p class="text-gray-600 text-sm leading-relaxed">
                        <span data-lang-en>Collaborate with international partners and publish your
                        work in prestigious journal and conference (e.g.,
                        IEEE/ACM Trans., CVPR, ICRA).</span><span data-lang-zh>與國際夥伴合作，並在頂尖期刊與會議（如 IEEE/ACM Trans.、CVPR、ICRA）發表研究成果。</span>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Open Positions -->
    <section class="section-padding bg-gray-bg">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <SectionHeader
                title="Open Positions"
                titleZh="開放職缺"
                subtitle="We welcome talented individuals at all levels"
                subtitleZh="我們歡迎各階段的優秀人才加入"
            />

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- PhD Students -->
                <div
                    class="p-8 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group relative overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 w-24 h-24 bg-accent/5 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-150"
                    >
                    </div>
                    <div class="relative z-10">
                        <div
                            class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-accent group-hover:text-white transition-colors text-accent"
                        >
                            <svg
                                class="w-7 h-7"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 14l9-5-9-5-9 5 9 5z"></path><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                                ></path><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"
                                ></path></svg
                            >
                        </div>
                        <h3
                            class="text-xl font-semibold text-navy mb-3 group-hover:text-accent transition-colors"
                        >
                            <span data-lang-en>Ph.D. Students</span><span data-lang-zh>博士生</span>
                        </h3>
                        <p class="text-gray-600 mb-6 text-sm leading-relaxed">
                            <span data-lang-en>We are looking for highly motivated Ph.D. candidates
                            with strong background in computer science,
                            electrical engineering, or related fields.</span><span data-lang-zh>我們尋找具高度積極性、擁有資訊工程、電機工程或相關領域紮實背景的博士候選人。</span>
                        </p>
                        <div class="flex flex-wrap gap-2 mt-auto">
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"
                                ><span data-lang-en>Fully Funded</span><span data-lang-zh>全額獎學金</span></span
                            >
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"
                                ><span data-lang-en>RA Support</span><span data-lang-zh>研究助理補助</span></span
                            >
                        </div>
                    </div>
                </div>

                <!-- Master's Students -->
                <div
                    class="p-8 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group relative overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 w-24 h-24 bg-accent/5 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-150"
                    >
                    </div>
                    <div class="relative z-10">
                        <div
                            class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-accent group-hover:text-white transition-colors text-accent"
                        >
                            <svg
                                class="w-7 h-7"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                ></path></svg
                            >
                        </div>
                        <h3
                            class="text-xl font-semibold text-navy mb-3 group-hover:text-accent transition-colors"
                        >
                            <span data-lang-en>Master's Students</span><span data-lang-zh>碩士生</span>
                        </h3>
                        <p class="text-gray-600 mb-6 text-sm leading-relaxed">
                            <span data-lang-en>Opportunities to work on industry-sponsored projects
                            and publish at top conferences in AI and robotics.</span><span data-lang-zh>有機會參與業界合作專案，並在 AI 與機器人領域頂尖會議發表論文。</span>
                        </p>
                        <div class="flex flex-wrap gap-2 mt-auto">
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800"
                                ><span data-lang-en>Research Projects</span><span data-lang-zh>研究專案</span></span
                            >
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800"
                                ><span data-lang-en>Industry Collaboration</span><span data-lang-zh>產學合作</span></span
                            >
                        </div>
                    </div>
                </div>

                <!-- Undergraduate -->
                <div
                    class="p-8 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group relative overflow-hidden"
                >
                    <div
                        class="absolute top-0 right-0 w-24 h-24 bg-accent/5 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-150"
                    >
                    </div>
                    <div class="relative z-10">
                        <div
                            class="w-14 h-14 bg-accent/10 rounded-xl flex items-center justify-center mb-6 group-hover:bg-accent group-hover:text-white transition-colors text-accent"
                        >
                            <svg
                                class="w-7 h-7"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                                ><path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                                ></path></svg
                            >
                        </div>
                        <h3
                            class="text-xl font-semibold text-navy mb-3 group-hover:text-accent transition-colors"
                        >
                            <span data-lang-en>Undergrad Researchers</span><span data-lang-zh>大學部研究生</span>
                        </h3>
                        <p class="text-gray-600 mb-6 text-sm leading-relaxed">
                            <span data-lang-en>Join via independent study or research
                            assistantship. Great opportunity to gain hands-on
                            experience and prepare for graduate school.</span><span data-lang-zh>透過獨立研究或研究助理職位加入，累積實作經驗並為研究所做準備。</span>
                        </p>
                        <div class="flex flex-wrap gap-2 mt-auto">
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-100 text-cyan-800"
                                ><span data-lang-en>Independent Study</span><span data-lang-zh>獨立研究</span></span
                            >
                            <span
                                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-pink-100 text-pink-800"
                                ><span data-lang-en>Capstone Projects</span><span data-lang-zh>專題製作</span></span
                            >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Requirements -->
    <section class="section-padding bg-white">
