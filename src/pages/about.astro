                            d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                            clip-rule="evenodd"></path>
                    </svg>
                    <span class="filter-label"
                        ><span data-lang-en>Merit Awards</span><span
                            data-lang-zh>傑出獎</span
                        ></span
                    ><span class="filter-count"> ({meritAwards.length})</span>
                </button>
                <button
                    class="pi-filter-btn px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer hover:-translate-y-0.5 flex items-center gap-1.5"
                    data-filter="paper"
                    aria-pressed="false"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                        ></path>
                    </svg>
                    <span class="filter-label"
                        ><span data-lang-en>Paper Awards</span><span
                            data-lang-zh>論文獎</span
                        ></span
                    ><span class="filter-count"> ({paperAwards.length})</span>
                </button>
                <button
                    class="pi-filter-btn px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200 cursor-pointer hover:-translate-y-0.5 flex items-center gap-1.5"
                    data-filter="competition"
                    aria-pressed="false"
                >
                    <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M5 5a3 3 0 015-2.236A3 3 0 0114.83 6H16a2 2 0 110 4h-5V9a1 1 0 10-2 0v1H4a2 2 0 110-4h1.17C5.06 5.687 5 5.35 5 5zm4 1V5a1 1 0 10-1 1h1zm3 0a1 1 0 10-1-1v1h1z"
                            clip-rule="evenodd"></path>
                        <path
                            d="M9 11H3v5a2 2 0 002 2h4v-7zM11 18h4a2 2 0 002-2v-5h-6v7z"
                        ></path>
                    </svg>
                    <span class="filter-label"
                        ><span data-lang-en>Competition Awards</span><span
                            data-lang-zh>競賽獎</span
                        ></span
                    ><span class="filter-count">
                        ({competitionAwards.length})</span
                    >
                </button>
            </div>

            <!-- Awards List by Year -->
            <div id="pi-awards-container">
                {
                    [...new Set(sortedAwards.map((a) => a.year))].map(
                        (year) => (
                            <div
                                class="pi-year-group mb-12 last:mb-0"
                                data-year={year}
                            >
                                <div class="year-header flex items-center gap-4 mb-6 py-2">
                                    <div class="text-2xl font-bold text-navy">
                                        {year}
                                    </div>
                                    <div class="flex-1 h-px bg-gradient-to-r from-accent/50 to-transparent" />
                                    <span class="text-sm text-gray-400 font-medium pi-year-count">
                                        {
                                            sortedAwards.filter(
                                                (a) => a.year === year,
                                            ).length
                                        }{" "}
                                        <span data-lang-en>
                                            {sortedAwards.filter(
                                                (a) => a.year === year,
                                            ).length > 1
                                                ? "awards"
                                                : "award"}
                                        </span>
                                        <span data-lang-zh>個獎項</span>
                                    </span>
                                </div>
                                <div class="grid md:grid-cols-2 gap-6 pi-awards-grid">
                                    {sortedAwards
                                        .filter((a) => a.year === year)
                                        .map((award) => (
                                            <div
                                                class="pi-award-item"
                                                data-category={award.category}
                                            >
                                                <PIAwardCard
                                                    title={award.title}
                                                    titleZh={award.title_zh}
                                                    event={award.event}
                                                    eventZh={award.event_zh}
                                                    year={award.year}
                                                    category={award.category}
                                                />
                                            </div>
                                        ))}
                                </div>
                            </div>
                        ),
                    )
                }
            </div>
        </div>
    </section>

    <script>
        import { countUnit, onLangChange } from "../scripts/i18n";

        const piFilterBtns = document.querySelectorAll(".pi-filter-btn");
        const piYearGroups = document.querySelectorAll(".pi-year-group");

        // Auto-update counts
        function updateCounts() {
            const meritCount = document.querySelectorAll(
                '.pi-award-item[data-category="merit"]',
            ).length;
            const paperCount = document.querySelectorAll(
                '.pi-award-item[data-category="paper"]',
            ).length;
            const competitionCount = document.querySelectorAll(
                '.pi-award-item[data-category="competition"]',
            ).length;
            const counts: Record<string, number> = {
                all: meritCount + paperCount + competitionCount,
                merit: meritCount,
                paper: paperCount,
                competition: competitionCount,
            };

            // Only update the count span — leave the bilingual .filter-label and
            // the SVG icon intact (textContent on the whole button would wipe them).
            piFilterBtns.forEach((btn) => {
                const filter = btn.getAttribute("data-filter");
                const countEl = btn.querySelector(".filter-count");
                if (countEl && filter && filter in counts) {
                    countEl.textContent = ` (${counts[filter]})`;
                }
            });
        }
        updateCounts();

        function applyPiFilter(filter: string) {
            piYearGroups.forEach((group) => {
                const items = group.querySelectorAll(".pi-award-item");
                let visibleCount = 0;

                items.forEach((item) => {
                    if (
                        filter === "all" ||
                        item.getAttribute("data-category") === filter
                    ) {
                        item.classList.remove("hidden");
                        visibleCount++;
                    } else {
                        item.classList.add("hidden");
                    }
                });

                // Update year count in the active language
                const yearCountEl = group.querySelector(".pi-year-count");
                if (yearCountEl) {
                    yearCountEl.textContent = countUnit(
                        visibleCount,
                        "award",
                        "awards",
                        "個獎項",
                    );
                }

                group.classList.toggle("hidden", visibleCount === 0);
            });
        }

        function piCurrentFilter(): string {
            const active = document.querySelector(".pi-filter-btn.active");
            return active?.getAttribute("data-filter") || "all";
        }

        piFilterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                piFilterBtns.forEach((b) => {
                    b.classList.remove(
                        "active",
                        "bg-accent",
                        "text-white",
                        "shadow-lg",
                        "shadow-accent/30",
                    );
                    b.classList.add(
                        "bg-gray-100",
                        "text-gray-700",
                        "hover:bg-gray-200",
                    );
                    b.setAttribute("aria-pressed", "false");
                });
                btn.classList.add(
                    "active",
                    "bg-accent",
                    "text-white",
                    "shadow-lg",
                    "shadow-accent/30",
                );
                btn.classList.remove(
                    "bg-gray-100",
                    "text-gray-700",
                    "hover:bg-gray-200",
                );
                btn.setAttribute("aria-pressed", "true");

                applyPiFilter(btn.getAttribute("data-filter") || "all");
            });
        });

        // Re-render year counts in the active language (load + langchange).
        onLangChange(() => applyPiFilter(piCurrentFilter()));
    </script>
    <!-- Back to Top Button -->
    <button
        id="back-to-top"
        class="fixed bottom-8 right-8 bg-accent text-white p-3 rounded-full shadow-lg opacity-0 invisible transition-all duration-300 z-50 hover:-translate-y-1 hover:shadow-accent/50 group"
        aria-label="Back to Top"
        data-i18n-aria-en="Back to Top"
        data-i18n-aria-zh="回到頂部"
    >
        <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
        </svg>
    </button>

    <script>
        // Back to Top Button Logic
        const backToTopBtn = document.getElementById("back-to-top");

        window.addEventListener("scroll", () => {
            if (window.scrollY > 300) {
                backToTopBtn?.classList.remove("opacity-0", "invisible");
            } else {
                backToTopBtn?.classList.add("opacity-0", "invisible");
            }
        });

        backToTopBtn?.addEventListener("click", () => {
            window.scrollTo({
                top: 0,
                behavior: "smooth",
            });
        });
    </script>
</BaseLayout>
