---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import LangText from "../components/i18n/LangText.astro";
import LangBlock from "../components/i18n/LangBlock.astro";
import PIAwardCard from "../components/PIAwardCard.astro";
import TimelineCard from "../components/TimelineCard.astro";
import awards from "../data/awards.json";

// Sort awards by year descending and exclude student merit awards
const sortedAwards = [...awards]
    .filter((a) => a.category !== "student_merit")
    .sort((a, b) => b.year - a.year);
const meritAwards = sortedAwards.filter((a) => a.category === "merit");
const paperAwards = sortedAwards.filter((a) => a.category === "paper");
const competitionAwards = sortedAwards.filter(
    (a) => a.category === "competition",
);

// Helper function to get border color class by category
const getBorderColor = (category: string) => {
    switch (category) {
        case "merit":
            return "border-l-amber-500";
        case "paper":
            return "border-l-blue-500";
        case "competition":
            return "border-l-emerald-500";
        default:
            return "border-l-gray-500";
    }
};

// Helper function to get text color class by category
const getTextColor = (category: string) => {
    switch (category) {
        case "merit":
            return "text-amber-600";
        case "paper":
            return "text-blue-600";
        case "competition":
            return "text-green-600";
        default:
            return "text-gray-600";
    }
};

// Structured data: profile page for the PI
const siteUrl = "https://sinyejhong.github.io";
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    mainEntity: {
        "@type": "Person",
        name: "Sin-Ye Jhong",
        alternateName: "鍾昕燁",
        jobTitle: "Assistant Professor",
        email: "sinyejhong@mail.ntust.edu.tw",
        url: `${siteUrl}/about/`,
        image: `${siteUrl}/images/members/sinyejhong2.jpg`,
        affiliation: {
            "@type": "CollegeOrUniversity",
            name: "National Taiwan University of Science and Technology",
            alternateName: "NTUST",
        },
        worksFor: {
            "@type": "ResearchOrganization",
            name: "ASI² Lab",
        },
        sameAs: [
            "https://scholar.google.com/citations?user=0aR6RcIAAAAJ&hl=zh-TW",
            "https://innc.ntust.edu.tw/p/405-1111-137656,c11515.php?Lang=zh-tw",
            "https://arspb.nstc.gov.tw/NSCWebFront/modules/talentSearch/talentSearch.do?action=initBasic&rsNo=8ef9a4d44c0245c09942f8aa25de49df&LANG=chi",
        ],
    },
};
