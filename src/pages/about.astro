    <script>
        // Professional Activities Filter (Service & Engagement Section)
        const paFilterBtns = document.querySelectorAll(".pa-filter-btn");
        const paItems = document.querySelectorAll(".pa-item");

        // Update counts dynamically
        function updatePACounts() {
            const counts: Record<string, number> = {
                thesis: document.querySelectorAll(
                    '.pa-item[data-category="thesis"]',
                ).length,
                conference: document.querySelectorAll(
                    '.pa-item[data-category="conference"]',
                ).length,
                talks: document.querySelectorAll(
                    '.pa-item[data-category="talks"]',
                ).length,
            };

            // Only update the count span — keep the bilingual .filter-label intact.
            paFilterBtns.forEach((btn) => {
                const filter = btn.getAttribute("data-filter");
                const countEl = btn.querySelector(".filter-count");
                if (countEl && filter && filter in counts) {
                    countEl.textContent = ` (${counts[filter]})`;
                }
            });
        }
        updatePACounts();

        paFilterBtns.forEach((btn) => {
            btn.addEventListener("click", () => {
                // Update button styles
                paFilterBtns.forEach((b) => {
                    b.classList.remove(
                        "active",
                        "bg-accent",
                        "text-white",
                        "shadow-lg",
                        "shadow-accent/30",
                    );
                    b.classList.add(
                        "bg-gray-100",
                        "text-gray-700",
                        "hover:bg-gray-200",
                    );
                    b.setAttribute("aria-pressed", "false");
                });
                btn.classList.add(
                    "active",
                    "bg-accent",
                    "text-white",
                    "shadow-lg",
                    "shadow-accent/30",
                );
                btn.classList.remove(
                    "bg-gray-100",
                    "text-gray-700",
                    "hover:bg-gray-200",
                );
                btn.setAttribute("aria-pressed", "true");

                // Filter items
                const filter = btn.getAttribute("data-filter");
                paItems.forEach((item) => {
                    if (item.getAttribute("data-category") === filter) {
                        item.classList.remove("hidden");
                    } else {
                        item.classList.add("hidden");
                    }
                });
            });
        });
    </script>

