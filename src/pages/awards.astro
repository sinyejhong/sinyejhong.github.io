---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import AwardCard from "../components/AwardCard.astro";
import LangBlock from "../components/i18n/LangBlock.astro";
import awards from "../data/awards.json";

// Filter for 2025+ and sort by year descending, excluding PI awards
const sortedAwards = [...awards]
    .filter(
        (a) =>
            a.year >= 2025 &&
            (a.category === "student_merit" ||
                a.category === "paper" ||
                a.category === "competition"),
    )
    .sort((a, b) => b.year - a.year);

const meritAwards = sortedAwards.filter((a) => a.category === "student_merit");
const paperAwards = sortedAwards.filter((a) => a.category === "paper");
const competitionAwards = sortedAwards.filter(
    (a) => a.category === "competition",
);
---

<BaseLayout
    title="Lab & Student Awards"
    description="Awards and honors won by ASI² Lab students and team at NTUST — best paper awards, competition prizes, and recognitions in AI, robotics, and electronic design."
>
    <!-- Hero -->
    <section class="bg-gradient-to-br from-navy to-navy-light text-white py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1
                class="text-4xl md:text-5xl font-heading font-bold mb-4 text-white"
            >
                <span data-lang-en>Lab & Student Awards</span><span data-lang-zh>實驗室與學生獎項</span>
            </h1>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto mb-4">
                <span data-lang-en>Celebrating our students' excellence and team achievements under
                Dr. Jhong's guidance</span><span data-lang-zh>記錄本實驗室學生與團隊在競賽與學術活動中的獲獎成果</span>
            </p>
            <LangBlock as="p" class="text-gray-400 max-w-2xl mx-auto mb-8">
                <Fragment slot="en">
                    Competition wins and recognitions achieved by ASI² LAB members.
                    For the PI's personal academic honors, visit
                    <a href="/about#honors" class="text-accent hover:underline"
                        >Personal Honors & Awards</a
                    >.
                </Fragment>
                <Fragment slot="zh">
                    ASI² LAB 成員獲得的各項競賽與學術肯定。
                    主持人的個人學術榮譽請見
                    <a href="/about#honors" class="text-accent hover:underline"
                        >Personal Honors & Awards</a
                    >。
                </Fragment>
            </LangBlock>

            <!-- Total Counter -->
            <div
                class="inline-flex items-center gap-3 px-8 py-4 bg-white/10 rounded-2xl backdrop-blur-sm border border-white/20"
            >
                <div class="text-5xl font-heading font-bold text-accent">
                    {sortedAwards.length}
                </div>
                <div class="text-left">
                    <div class="text-xl font-semibold"><span data-lang-en>Total Awards</span><span data-lang-zh>獎項總計</span></div>
                    <div class="text-gray-400 text-sm">(2025 - Present)</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Filter Tabs -->
    <section
        class="sticky top-12 lg:top-14 z-40 bg-white border-b border-gray-border shadow-sm"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex flex-wrap justify-center gap-2" id="award-filters">
                <button
                    class="filter-btn active px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-accent text-white shadow-lg shadow-accent/30"
                    data-filter="all"
                >
                    <span data-lang-en>All</span><span data-lang-zh>全部</span> ({sortedAwards.length})
                </button>
                <button
                    class="filter-btn px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200"
                    data-filter="student_merit"
                >
                    🏅 <span data-lang-en>Student Merit Awards</span><span data-lang-zh>學生榮譽獎</span> ({meritAwards.length})
                </button>
                <button
                    class="filter-btn px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200"
                    data-filter="paper"
                >
                    📄 <span data-lang-en>Paper Awards</span><span data-lang-zh>論文獎</span> ({paperAwards.length})
                </button>
                <button
                    class="filter-btn px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 bg-gray-100 text-gray-700 hover:bg-gray-200"
                    data-filter="competition"
                >
                    🏆 <span data-lang-en>Competition Awards</span><span data-lang-zh>競賽獎</span> ({competitionAwards.length})
                </button>
            </div>
        </div>
    </section>

    <!-- Awards List by Year -->
    <section class="section-padding bg-gray-bg">
        <div
            class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8"
            id="awards-container"
        >
            {
                [...new Set(sortedAwards.map((a) => a.year))].map((year) => {
                    const yearAwards = sortedAwards.filter((a) => a.year === year);
                    return (
                        <div class="year-group mb-10 last:mb-0" data-year={year}>
                            <!-- Year Header (Publications Style) -->
                            <div class="year-header flex items-center gap-4 mb-6 py-2">
                                <div class="text-2xl font-bold text-navy">{year}</div>
                                <div class="flex-1 h-px bg-gradient-to-r from-accent/50 to-transparent"></div>
                                <span class="text-sm text-gray-400 font-medium year-count">
                                    {yearAwards.length} {yearAwards.length > 1 ? 'awards' : 'award'}
                                </span>
                            </div>
                            
                            <!-- Awards Grid -->
                            <div class="grid md:grid-cols-2 gap-6 awards-grid">
                                {yearAwards.map((award) => (
                                    <div
                                        class="award-item"
                                        data-category={award.category}
                                    >
                                        <AwardCard
                                            title={award.title}
                                            event={award.event}
                                            eventZh={award.event_zh}
                                            year={award.year}
                                            category={award.category}
                                            description={award.description}
                                            descriptionZh={award.description_zh}
                                        />
                                    </div>
                                ))}
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </section>
</BaseLayout>

<script>
    import { countUnit, onLangChange } from "../scripts/i18n";

    const filterBtns = document.querySelectorAll(".filter-btn");
    const yearGroups = document.querySelectorAll(".year-group");

    function applyFilter(filter: string) {
        yearGroups.forEach((group) => {
            const items = group.querySelectorAll(".award-item");
            let visibleCount = 0;

            items.forEach((item) => {
                if (
                    filter === "all" ||
                    item.getAttribute("data-category") === filter
                ) {
                    item.classList.remove("hidden");
                    visibleCount++;
                } else {
                    item.classList.add("hidden");
                }
            });

            // Update year count in the active language
            const yearCountEl = group.querySelector(".year-count");
            if (yearCountEl) {
                yearCountEl.textContent = countUnit(
                    visibleCount,
                    "award",
                    "awards",
                    "個獎項",
                );
            }

            group.classList.toggle("hidden", visibleCount === 0);
        });
    }

    function currentFilter(): string {
        const active = document.querySelector(".filter-btn.active");
        return active?.getAttribute("data-filter") || "all";
    }

    filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
            filterBtns.forEach((b) => {
                b.classList.remove(
                    "active",
                    "bg-accent",
                    "text-white",
                    "shadow-lg",
                    "shadow-accent/30",
                );
                b.classList.add(
                    "bg-gray-100",
                    "text-gray-700",
                    "hover:bg-gray-200",
                );
            });
            btn.classList.add(
                "active",
                "bg-accent",
                "text-white",
                "shadow-lg",
                "shadow-accent/30",
            );
            btn.classList.remove(
                "bg-gray-100",
                "text-gray-700",
                "hover:bg-gray-200",
            );

            applyFilter(btn.getAttribute("data-filter") || "all");
        });
    });

    // Re-render year counts in the active language (runs on load + langchange).
    onLangChange(() => applyFilter(currentFilter()));
</script>
