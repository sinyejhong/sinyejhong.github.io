---
// Language toggle button. Shows the *target* language label ("中文" while in
// English, "EN" while in Chinese — driven by the same data-lang CSS rules).
// Click handling + aria-label sync live in src/scripts/i18n.ts.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<button
  type="button"
  data-lang-toggle
  aria-pressed="false"
  data-i18n-aria-en="Switch language"
  data-i18n-aria-zh="切換語言"
  aria-label="Switch language"
  class:list={[
    "inline-flex items-center justify-center gap-1.5 min-h-[44px] px-2.5 rounded-lg text-sm font-medium text-navy hover:text-accent hover:bg-gray-bg transition-colors",
    className,
  ]}
>
  <svg
    class="w-4 h-4"
    fill="none"
    stroke="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"
    ></path>
  </svg>
  <span data-lang-en>中文</span><span data-lang-zh>EN</span>
</button>
