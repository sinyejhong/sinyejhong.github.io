---
import defaultNews from "../data/news.json";

interface NewsItem {
    text: string;
    text_zh?: string;
    date: string;
    highlights?: string[];
    highlights_zh?: string[];
    images?: string[];
    pillar?: string;
    links?: Record<string, string>;
    links_zh?: Record<string, string>;
    emphasis?: string[];
    emphasis_zh?: string[];
}

interface Props {
    data?: NewsItem[];
    title?: string;
    titleZh?: string;
    subtitle?: string;
    subtitleZh?: string;
    idPrefix?: string;
    bg?: string;
}

const {
    data = defaultNews as NewsItem[],
    title = "Latest News",
    titleZh,
    subtitle = "Recent breakthroughs, publications, and lab announcements",
    subtitleZh,
    idPrefix = "news",
    bg = "bg-gray-50/50",
} = Astro.props;

// Config: 3 items per page for a "Grid" feel
const itemsPerPage = 3;
const totalPages = Math.ceil(data.length / itemsPerPage);

// Helper: Highlight Text
function escapeHtml(s: string): string {
    return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;");
}

// Build highlighted HTML from PLAIN text by computing non-overlapping ranges
// (priority: link > emphasis > highlight), escaping the text, then wrapping
// each range. This avoids the old regex-replace approach injecting markup into
// already-inserted tags, and is safe for Chinese (no \b word boundaries).
// Each label is matched at its first occurrence in the text.
function highlightText(
    text: string,
    highlights?: string[],
    links?: Record<string, string | undefined>,
    emphasis?: string[],
): string {
    type Span = { start: number; end: number; type: string; url?: string };
    const spans: Span[] = [];
    const overlaps = (s: number, e: number) =>
        spans.some((r) => s < r.end && e > r.start);
    const add = (label: string, type: string, url?: string) => {
        if (!label) return;
        const idx = text.indexOf(label);
        if (idx < 0) return;
        const end = idx + label.length;
        if (overlaps(idx, end)) return;
        spans.push({ start: idx, end, type, url });
    };

    if (links) {
        Object.entries(links).forEach(([label, url]) => {
            if (url) add(label, "link", url);
        });
    }
    if (emphasis) emphasis.forEach((e) => add(e, "emphasis"));
    if (highlights) highlights.forEach((h) => add(h, "highlight"));
    spans.sort((a, b) => a.start - b.start);

    let out = "";
    let pos = 0;
    for (const sp of spans) {
        out += escapeHtml(text.slice(pos, sp.start));
        const inner = escapeHtml(text.slice(sp.start, sp.end));
        if (sp.type === "link") {
            const href = escapeHtml(sp.url || "").replace(/"/g, "&quot;");
            out += `<a href="${href}" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline z-20 relative">${inner}</a>`;
        } else if (sp.type === "emphasis") {
            out += `<span class="font-bold text-navy">${inner}</span>`;
        } else {
            out += `<span class="text-accent font-semibold bg-accent/5 px-1 rounded">${inner}</span>`;
        }
        pos = sp.end;
    }
    out += escapeHtml(text.slice(pos));
    return out;
}

// Localized highlighted HTML: falls back to English fields when a _zh variant
// is missing, so a partially-translated item never blanks out in Chinese.
function highlightItem(item: NewsItem, lang: "en" | "zh"): string {
    if (lang === "zh") {
        return highlightText(
            item.text_zh ?? item.text,
            item.highlights_zh ?? item.highlights,
            item.links_zh ?? item.links,
            item.emphasis_zh ?? item.emphasis,
        );
    }
    return highlightText(item.text, item.highlights, item.links, item.emphasis);
}

// Helper: Pillar Config
const pillarConfig: Record<
    string,
    {
        label: string;
        labelZh: string;
        text: string;
        href: string;
        spacingClass?: string;
        spacing: string;
    }
> = {
    perception: {
        label: "Resilient Perception",
        labelZh: "韌性感知",
        text: "text-blue-700",
        href: "/research#perception",
        spacingClass: "space-y-1",
        spacing: "pr-1 pb-1 -mt-2",
    },
    inspection: {
        label: "Industrial AIoT",
        labelZh: "工業 AIoT",
        text: "text-emerald-700",
        href: "/research#inspection",
        spacingClass: "space-y-1",
        spacing: "pr-1 pb-0 -mt-3",
    },
    robotics: {
        label: "Embodied AI",
        labelZh: "具身智慧 AI",
        text: "text-purple-700",
        href: "/research#robotics",
        spacingClass: "space-y-1",
        spacing: "pr-1 pb-1 -mt-2",
    },
    academic: {
        label: "Academic",
        labelZh: "學術動態",
        text: "text-orange-700",
        href: "/about",
        spacingClass: "space-y-1",
        spacing: "pr-1 pb-1 -mt-2",
    },
    invited_talk: {
        label: "Invited Talk",
        labelZh: "受邀演講",
        text: "text-rose-700",
        href: "/about#professional-activities",
        spacingClass: "space-y-1",
        spacing: "pr-1 pb-1 -mt-2",
    },
    session_chair: {
        label: "Session Chair",
        labelZh: "議程主持",
        text: "text-amber-700",
        href: "/about#professional-activities",
        spacingClass: "space-y-1",
        spacing: "pr-1 pb-1 -mt-2",
    },
    thesis_committee: {
        label: "Thesis Committee",
        labelZh: "口試委員",
        text: "text-sky-700",
        href: "/about#professional-activities",
        spacingClass: "space-y-1",
        spacing: "pr-1 pb-1 -mt-2",
    },
    lab_visit: {
        label: "Lab Visit",
        labelZh: "實驗室參訪",
        text: "text-indigo-700",
        href: "/about#professional-activities",
        spacingClass: "space-y-1",
        spacing: "pr-1 pb-1 -mt-2",
    },
};

// Helper: Date Formatting
function getMonthAndDay(dateStr: string) {
    // Parse as UTC to avoid the date shifting a day in negative-offset timezones
    const [y, m, d] = dateStr.split("-").map(Number);
    const date = new Date(Date.UTC(y, m - 1, d));
    return {
        month: date
            .toLocaleDateString("en-US", { timeZone: "UTC", month: "short" })
            .toUpperCase(),
        monthZh: `${m}月`,
        day: date.getUTCDate(),
        year: date.getUTCFullYear(),
        fullEn: date.toLocaleDateString("en-US", {
            timeZone: "UTC",
            year: "numeric",
            month: "short",
            day: "numeric",
        }),
        fullZh: `${y}年${m}月${d}日`,
    };
}
---

<section class:list={["section-padding", bg]} data-carousel-id={idPrefix}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row items-center md:items-end justify-between mb-10 gap-4">
            <!-- Left Spacer for centering balance -->
            <div class="hidden md:block flex-1"></div>

            <!-- Center Title -->
            <div class="text-center flex-none">
                <h2
                    class="text-3xl md:text-4xl font-heading font-bold text-navy mb-3"
                >
                    {
                        titleZh ? (
                            <>
                                <span data-lang-en>{title}</span>
                                <span data-lang-zh>{titleZh}</span>
                            </>
                        ) : (
                            title
                        )
                    }
                </h2>
                <div class="w-20 h-1 bg-accent rounded-full mb-4 mx-auto"></div>
                <p class="text-gray-text text-lg max-w-2xl">
                    {
                        subtitleZh ? (
                            <>
                                <span data-lang-en>{subtitle}</span>
                                <span data-lang-zh>{subtitleZh}</span>
                            </>
                        ) : (
                            subtitle
                        )
                    }
                </p>
            </div>

            <!-- Right Controls -->
            <div class="flex items-center gap-3 w-full md:w-auto md:flex-1 justify-center md:justify-end mt-4 md:mt-0">
                <button
                    id={`${idPrefix}-prev`}
                    class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/95 backdrop-blur-sm shadow-md border-2 border-gray-200/80 flex items-center justify-center text-navy hover:bg-accent hover:text-white hover:border-accent hover:shadow-xl hover:scale-110 active:scale-95 transition-all duration-300 disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-navy disabled:hover:scale-100 cursor-pointer"
                    aria-label="Previous page"
                    data-i18n-aria-en="Previous page"
                    data-i18n-aria-zh="上一頁"
                >
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>
                <button
                    id={`${idPrefix}-next`}
                    class="w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/95 backdrop-blur-sm shadow-md border-2 border-gray-200/80 flex items-center justify-center text-navy hover:bg-accent hover:text-white hover:border-accent hover:shadow-xl hover:scale-110 active:scale-95 transition-all duration-300 disabled:opacity-30 disabled:hover:bg-white disabled:hover:text-navy disabled:hover:scale-100 cursor-pointer"
                    aria-label="Next page"
                    data-i18n-aria-en="Next page"
                    data-i18n-aria-zh="下一頁"
                >
                    <svg
                        class="w-6 h-6"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- News Grid Carousel -->
        <div class="relative min-h-[400px]" id={`${idPrefix}-container`}>
            {
                Array.from({ length: totalPages }).map((_, pageIndex) => (
                    <div
                        class:list={[
                            "carousel-page grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 transition-opacity duration-500 absolute inset-0 w-full items-stretch",
                            pageIndex === 0
                                ? "opacity-100 relative z-10"
                                : "opacity-0 absolute z-0 pointer-events-none",
                        ]}
                        data-page={pageIndex}
                        inert={pageIndex !== 0}
                    >
                        {data
                            .slice(
                                pageIndex * itemsPerPage,
                                (pageIndex + 1) * itemsPerPage,
                            )
                            .map((item, i) => {
                                const {
                                    month,
                                    monthZh,
                                    day,
                                    year,
                                    fullEn,
                                    fullZh,
                                } = getMonthAndDay(item.date);
                                const [iy, im, idd] = item.date
                                    .split("-")
                                    .map(Number);
                                const ageMs =
                                    Date.now() -
                                    Date.UTC(iy, im - 1, idd);
                                const isRecent =
                                    ageMs >= 0 && ageMs < 60 * 86400000;
                                const hasImage =
                                    item.images && item.images.length > 0;
                                const coverImage = hasImage
                                    ? item.images![0]
                                    : null;

                                return (
                                    <article
                                        class="group relative bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden flex flex-col h-full hover:-translate-y-1 read-more-btn cursor-pointer"
                                    >
                                        {/* Cover Image or Color Block */}
                                        <div class="h-48 overflow-hidden relative bg-navy/5">
                                            {coverImage ? (
                                                <img
                                                    src={coverImage}
                                                    alt="News cover"
                                                    data-i18n-alt-en="News cover"
                                                    data-i18n-alt-zh="新聞封面"
                                                    width="800"
                                                    height="600"
                                                    loading={pageIndex === 0 ? "eager" : "lazy"}
                                                    decoding="async"
                                                    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                                />
                                            ) : (
                                                <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-gray-50 to-gray-200">
                                                    <svg
                                                        class="w-12 h-12 text-gray-300"
                                                        fill="none"
                                                        stroke="currentColor"
                                                        viewBox="0 0 24 24"
                                                    >
                                                        <path
                                                            stroke-linecap="round"
                                                            stroke-linejoin="round"
                                                            stroke-width="1.5"
                                                            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
                                                        />
                                                    </svg>
                                                </div>
                                            )}

                                            {/* Date Block (Absolute) */}
                                            <div class="absolute top-4 left-4 bg-white/95 backdrop-blur shadow-md rounded-xl p-2 text-center min-w-[3.5rem] border border-gray-100">
                                                <div class="text-xs font-bold text-gray-500 uppercase tracking-wider">
                                                    <span data-lang-en
                                                        >{month}</span
                                                    ><span data-lang-zh
                                                        >{monthZh}</span
                                                    >
                                                </div>
                                                <div class="text-xl font-bold text-navy leading-none mt-0.5">
                                                    {day}
                                                </div>
                                            </div>


                                        </div>

                                        {/* Content */}
                                        <div class="p-6 flex flex-col flex-grow relative z-10">
                                            {/* Watermark Pillar Graphic */}
                                            {item.pillar &&
                                                pillarConfig[item.pillar] && (
                                                    <a
                                                        href={
                                                            pillarConfig[
                                                                item.pillar
                                                            ].href
                                                        }
                                                        class:list={[
                                                            "absolute bottom-0 right-0 flex flex-col items-end opacity-50 group-hover:opacity-100 transition-all duration-500 pointer-events-auto z-30",
                                                            pillarConfig[
                                                                item.pillar
                                                            ].text,
                                                            pillarConfig[
                                                                item.pillar
                                                            ].spacingClass,
                                                        ]}
                                                        onclick="event.stopPropagation()"
                                                        title={`Go to ${pillarConfig[item.pillar].label}`}
                                                        data-i18n-title-en={`Go to ${pillarConfig[item.pillar].label}`}
                                                        data-i18n-title-zh={`前往${pillarConfig[item.pillar].labelZh}`}
                                                    >
                                                        <div class="w-20 h-20 transform rotate-12 transition-transform duration-500 group-hover:rotate-0 group-hover:scale-110">
                                                            {item.pillar ===
                                                                "perception" && (
                                                                <svg
                                                                    class="w-full h-full"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"
                                                                    />
                                                                </svg>
                                                            )}
                                                            {item.pillar ===
                                                                "inspection" && (
                                                                <svg
                                                                    class="w-full h-full"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                                                    />
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                                                                    />
                                                                </svg>
                                                            )}
                                                            {item.pillar ===
                                                                "robotics" && (
                                                                <svg
                                                                    class="w-full h-full"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                                                                    />
                                                                </svg>
                                                            )}
                                                            {item.pillar ===
                                                                "academic" && (
                                                                <svg
                                                                    class="w-full h-full"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M12 14l9-5-9-5-9 5 9 5z"
                                                                    />
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"
                                                                    />
                                                                </svg>
                                                            )}
                                                            {item.pillar ===
                                                                "invited_talk" && (
                                                                <svg
                                                                    class="w-full h-full"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"
                                                                    />
                                                                </svg>
                                                            )}
                                                            {item.pillar ===
                                                                "session_chair" && (
                                                                <svg
                                                                    class="w-full h-full"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
                                                                    />
                                                                </svg>
                                                            )}
                                                            {item.pillar ===
                                                                "thesis_committee" && (
                                                                <svg
                                                                    class="w-full h-full"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                                                    />
                                                                </svg>
                                                            )}
                                                            {item.pillar ===
                                                                "lab_visit" && (
                                                                <svg
                                                                    class="w-full h-full"
                                                                    fill="none"
                                                                    stroke="currentColor"
                                                                    viewBox="0 0 24 24"
                                                                >
                                                                    <path
                                                                        stroke-linecap="round"
                                                                        stroke-linejoin="round"
                                                                        stroke-width="2"
                                                                        d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                                                                    />
                                                                </svg>
                                                            )}
                                                        </div>
                                                        <span
                                                            class:list={[
                                                                "text-[0.6rem] font-bold tracking-widest uppercase text-right opacity-0 group-hover:opacity-100 transition-opacity duration-300 transform translate-y-2 group-hover:translate-y-0",
                                                                pillarConfig[
                                                                    item.pillar
                                                                ].spacing,
                                                            ]}
                                                        >
                                                            <span data-lang-en>
                                                                {
                                                                    pillarConfig[
                                                                        item
                                                                            .pillar
                                                                    ].label
                                                                }
                                                            </span>
                                                            <span data-lang-zh>
                                                                {
                                                                    pillarConfig[
                                                                        item
                                                                            .pillar
                                                                    ].labelZh
                                                                }
                                                            </span>
                                                        </span>
                                                    </a>
                                                )}
                                            <div class="text-xs text-gray-400 mb-3 font-medium flex items-center gap-2">
                                                <span>{year}</span>
                                                {/* NEW badge for items dated within the last 60 days (computed at build time) */}
                                                {isRecent && (
                                                    <span class="px-2 py-0.5 bg-accent/10 text-accent rounded-full font-bold animate-pulse">
                                                        <span data-lang-en
                                                            >NEW</span
                                                        ><span data-lang-zh
                                                            >最新</span
