                                                    <div
                                                        data-lang-en
                                                        set:html={highlightItem(
                                                            item,
                                                            "en",
                                                        )}
                                                    />
                                                    <div
                                                        data-lang-zh
                                                        set:html={highlightItem(
                                                            item,
                                                            "zh",
                                                        )}
                                                    />
                                                </div>
                                                <div class="news-meta-date">
                                                    <span data-lang-en>{fullEn}</span><span data-lang-zh>{fullZh}</span>
                                                </div>
                                                <div class="news-meta-pillar" data-pillar={item.pillar}>
                                                    {item.pillar && pillarConfig[item.pillar] && (
                                                        <>
                                                            <span data-lang-en>{pillarConfig[item.pillar].label}</span>
                                                            <span data-lang-zh>{pillarConfig[item.pillar].labelZh}</span>
                                                        </>
                                                    )}
                                                </div>
                                                <div class="news-images">
                                                    {item.images && item.images.map(img => (
                                                        <span class="hidden-news-img" data-src={img}></span>
                                                    ))}
                                                </div>
                                            </div>




                                        </div>
                                    </article>
                                );
                            })}
                    </div>
                ))
            }
        </div>

        <!-- Pagination Dots (Desktop & Mobile) -->
        <div class="flex justify-center mt-8 gap-3">
            {
                Array.from({ length: totalPages }).map((_, i) => (
                    <button
                        class="mobile-dot group p-2 cursor-pointer"
                        data-index={i}
                        aria-label={`Go to page ${i + 1}`}
                        data-i18n-aria-en={`Go to page ${i + 1}`}
                        data-i18n-aria-zh={`前往第 ${i + 1} 頁`}
                    >
                        <span class="block w-3 h-3 rounded-full bg-gray-300 transition-all duration-300 group-hover:bg-accent/50 group-hover:scale-125 data-[active=true]:bg-accent data-[active=true]:w-8" data-active={i === 0 ? "true" : "false"}></span>
                    </button>
                ))
            }
        </div>
    </div>

    <!-- News Detail Modal -->
    <div
        id={`${idPrefix}-detail-modal`}
        class="fixed inset-0 z-[60] hidden flex items-center justify-center bg-navy/90 backdrop-blur-sm opacity-0 transition-opacity duration-300 px-4"
        role="dialog"
        aria-modal="true"
        aria-label="News detail"
        data-i18n-aria-en="News detail"
        data-i18n-aria-zh="最新消息詳情"
    >
        <div
            class="detail-content bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl relative transform scale-95 transition-transform duration-300 flex flex-col"
        >
             <!-- Close Button -->
            <button
                class="detail-close absolute top-4 right-4 p-2 bg-gray-100 hover:bg-gray-200 rounded-full text-gray-600 hover:text-navy transition-colors z-20"
                aria-label="Close news detail"
                data-i18n-aria-en="Close news detail"
                data-i18n-aria-zh="關閉最新消息詳情"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>

            <!-- Modal Content -->
            <div class="p-8">
                <div class="flex items-center gap-3 mb-6">
                     <span class="modal-date px-3 py-1 bg-gray-100 text-gray-600 rounded-lg text-sm font-semibold"></span>
                     <span class="modal-pillar hidden px-3 py-1 rounded-lg text-sm font-bold uppercase tracking-wide"></span>
                </div>

                <div class="modal-text prose prose-blue max-w-none text-lg leading-relaxed text-gray-700 mb-8">
                </div>

                <!-- Image Gallery in Modal -->
                <div class="modal-gallery space-y-4">
                </div>
            </div>
        </div>
    </div>
</section>

<script define:vars={{ totalPages, idPrefix }}>
    (function () {
        const root = document.querySelector(`[data-carousel-id="${idPrefix}"]`);
        if (!root) return;

        const detailModal = root.querySelector(`#${idPrefix}-detail-modal`);
        const detailContent = detailModal?.querySelector(".detail-content");
        const detailClose = detailModal?.querySelector(".detail-close");

        let currentPage = 0;
        let lastFocused = null;

        function openDetailModal(article) {
            if (!detailModal) return;
            const fullContentDiv = article.querySelector(".news-full-content");
            if (!fullContentDiv) return;

            const rawText =
                fullContentDiv.querySelector(".news-raw-text")?.innerHTML ?? "";
            const dateDiv = fullContentDiv.querySelector(".news-meta-date");
            const pillarDiv = fullContentDiv.querySelector(".news-meta-pillar");
            const pillar = pillarDiv?.dataset.pillar;
            const images = fullContentDiv.querySelectorAll(".hidden-news-img");

            // Copy bilingual payloads verbatim; html[data-lang] CSS shows the
            // active language, so switching while the modal is open just works.
            detailModal.querySelector(".modal-text").innerHTML = rawText;
            detailModal.querySelector(".modal-date").innerHTML =
                dateDiv?.innerHTML ?? "";

            const pillarSpan = detailModal.querySelector(".modal-pillar");
            pillarSpan.className =
                "modal-pillar hidden px-3 py-1 rounded-lg text-sm font-bold uppercase tracking-wide";
            if (pillar) {
                pillarSpan.classList.remove("hidden");
                pillarSpan.innerHTML = pillarDiv.innerHTML || pillar;
                const pillarColors = {
                    perception: ["bg-blue-100", "text-blue-700"],
                    inspection: ["bg-emerald-100", "text-emerald-700"],
                    robotics: ["bg-purple-100", "text-purple-700"],
                    academic: ["bg-orange-100", "text-orange-700"],
                    invited_talk: ["bg-rose-100", "text-rose-700"],
                    session_chair: ["bg-amber-100", "text-amber-700"],
                    thesis_committee: ["bg-sky-100", "text-sky-700"],
                    lab_visit: ["bg-indigo-100", "text-indigo-700"],
                };
                const colors = pillarColors[pillar] || [
                    "bg-orange-100",
                    "text-orange-700",
                ];
                pillarSpan.classList.add(...colors);
            } else {
                pillarSpan.classList.add("hidden");
            }

            const gallery = detailModal.querySelector(".modal-gallery");
            gallery.innerHTML = "";
            images.forEach((el) => {
                const src = el.dataset.src;
                if (!src) return;
                const newImg = document.createElement("img");
                newImg.src = src;
                newImg.alt = "";
                newImg.loading = "lazy";
                newImg.className =
                    "w-full rounded-xl shadow-md border border-gray-100";
                gallery.appendChild(newImg);
            });

            lastFocused = document.activeElement;
            detailModal.classList.remove("hidden");
            document.body.style.overflow = "hidden";
            requestAnimationFrame(() => {
                detailModal.classList.remove("opacity-0");
                detailContent?.classList.remove("scale-95");
                detailContent?.classList.add("scale-100");
                detailClose?.focus();
            });
        }

        function closeDetailModal() {
            if (!detailModal) return;
            detailModal.classList.add("opacity-0");
            if (detailContent) {
                detailContent.classList.remove("scale-100");
                detailContent.classList.add("scale-95");
            }
            setTimeout(() => {
                detailModal.classList.add("hidden");
                document.body.style.overflow = "";
                // Restore focus only after the dialog is fully hidden (a11y timing)
                if (lastFocused && typeof lastFocused.focus === "function") {
                    lastFocused.focus();
                    lastFocused = null;
                }
            }, 300);
        }

        detailClose?.addEventListener("click", closeDetailModal);

        // Open detail modal on card click (scoped to this carousel)
        root.addEventListener("click", (e) => {
            if (!(e.target instanceof Element)) return;
            // Skip if click landed on an inline link inside the card
            if (e.target.closest("a")) return;
            const btn = e.target.closest(".read-more-btn");
            if (btn && root.contains(btn)) {
                const article = btn.closest("article");
                if (article) openDetailModal(article);
            }
        });

        detailModal?.addEventListener("click", (e) => {
            if (e.target === detailModal) closeDetailModal();
        });

        // Focus trap: keep Tab within the open modal
        detailModal?.addEventListener("keydown", (e) => {
            if (e.key !== "Tab" || !detailModal) return;
            const focusables = [
                ...detailModal.querySelectorAll(
                    'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
                ),
            ].filter((el) => el.offsetParent !== null);
            if (!focusables.length) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (e.shiftKey && document.activeElement === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && document.activeElement === last) {
                e.preventDefault();
                first.focus();
            }
        });

        document.addEventListener("keydown", (e) => {
            if (
                e.key === "Escape" &&
                detailModal &&
                !detailModal.classList.contains("hidden")
            ) {
                closeDetailModal();
            }
        });

        // Carousel navigation (scoped to this carousel)
        const container = root.querySelector(`#${idPrefix}-container`);
        const pages = root.querySelectorAll(".carousel-page");
        const prevBtn = root.querySelector(`#${idPrefix}-prev`);
        const nextBtn = root.querySelector(`#${idPrefix}-next`);
        const mobileDots = root.querySelectorAll(".mobile-dot");

        function updateView(newIndex) {
            if (newIndex < 0 || newIndex >= totalPages) return;
            currentPage = newIndex;

            pages.forEach((page, i) => {
                const isCurrent = i === currentPage;
                if (isCurrent) {
                    page.classList.remove(
                        "opacity-0",
                        "absolute",
                        "z-0",
                        "pointer-events-none",
                    );
                    page.classList.add("opacity-100", "relative", "z-10");
                    page.removeAttribute("inert");
                } else {
                    page.classList.remove("opacity-100", "relative", "z-10");
                    page.classList.add(
                        "opacity-0",
                        "absolute",
                        "z-0",
                        "pointer-events-none",
                    );
                    page.setAttribute("inert", "");
                }
            });

            if (prevBtn) prevBtn.disabled = currentPage === 0;
            if (nextBtn) nextBtn.disabled = currentPage === totalPages - 1;

            mobileDots.forEach((dot, i) => {
                const span = dot.querySelector("span");
                if (span) {
                    span.setAttribute("data-active", i === currentPage ? "true" : "false");
                }
            });
        }

        prevBtn?.addEventListener("click", () => updateView(currentPage - 1));
        nextBtn?.addEventListener("click", () => updateView(currentPage + 1));

        mobileDots.forEach((dot) => {
            dot.addEventListener("click", (e) => {
                const btn = e.target.closest(".mobile-dot");
                if (btn) {
                    const index = parseInt(btn.dataset.index);
                    if (!isNaN(index)) updateView(index);
                }
            });
        });

        // Auto-cycle (first 2 pages only)
        const AUTO_CYCLE_INTERVAL = 10000;
        const AUTO_CYCLE_MAX_PAGE = 1;
        let autoPlayTimer = null;
        let isPaused = false;
        let interactionTimeout = null;

        function startAutoCycle() {
            if (autoPlayTimer) clearInterval(autoPlayTimer);
            autoPlayTimer = setInterval(() => {
                const isDetailOpen = detailModal && !detailModal.classList.contains("hidden");
                if (isPaused || isDetailOpen) return;
                const nextPage =
                    currentPage >= AUTO_CYCLE_MAX_PAGE ? 0 : currentPage + 1;
                updateView(nextPage);
            }, AUTO_CYCLE_INTERVAL);
        }

        function pauseAutoCycle() {
            isPaused = true;
        }

        function resumeAutoCycle() {
            if (!interactionTimeout) isPaused = false;
        }

        function handleUserInteraction() {
            isPaused = true;
            if (interactionTimeout) clearTimeout(interactionTimeout);
            interactionTimeout = setTimeout(() => {
                isPaused = false;
                interactionTimeout = null;
            }, 15000);
        }

        container?.addEventListener("mouseenter", pauseAutoCycle);
        container?.addEventListener("mouseleave", resumeAutoCycle);
        prevBtn?.addEventListener("click", handleUserInteraction);
        nextBtn?.addEventListener("click", handleUserInteraction);
        mobileDots.forEach((dot) =>
            dot.addEventListener("click", handleUserInteraction),
        );

        const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        if (totalPages > 1 && !prefersReducedMotion) startAutoCycle();

        // Touch swipe support
        let touchStartX = 0;
        let touchEndX = 0;
        const SWIPE_THRESHOLD = 50;

        container?.addEventListener(
            "touchstart",
            (e) => {
                touchStartX = e.changedTouches[0].screenX;
            },
            { passive: true },
        );

        container?.addEventListener("touchend", (e) => {
            touchEndX = e.changedTouches[0].screenX;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > SWIPE_THRESHOLD) {
                if (diff > 0) updateView(currentPage + 1);
                else updateView(currentPage - 1);
                handleUserInteraction();
            }
        });

        updateView(0);
    })();
</script>
