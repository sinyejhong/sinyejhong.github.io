                                                        item,
                                                        "en",
                                                    )}
                                                /><span
                                                    data-lang-zh
                                                    set:html={highlightItem(
                                                        item,
                                                        "zh",
                                                    )}
                                                />
                                            </div>

                                            <button
                                                type="button"
                                                class="news-open-detail self-start inline-flex items-center gap-1 text-sm font-bold text-accent hover:gap-2 transition-all mb-4"
